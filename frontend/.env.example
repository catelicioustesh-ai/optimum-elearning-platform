# Copy to .env.local for local dev (Vite auto-loads it, git-ignored by default)
# Local Vite proxies /api, /admin, and /media to Django so session cookies
# stay on the frontend origin (works with both localhost and 127.0.0.1).
# Override only when the API is hosted separately.
VITE_API_URL=/api
# Optional public OAuth client IDs. Each provider is disabled when its ID is unset.
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
# Must match the return URL registered with Apple. Defaults to the frontend origin.
VITE_APPLE_REDIRECT_URI=
